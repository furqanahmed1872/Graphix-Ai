# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin, used for CORS. Must be the exact deployed URL in
# production (e.g. https://graphix.netlify.app) or every request is blocked.
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# LOCAL: docker-compose.dev.yml
DATABASE_URL=postgresql://graphix_user:graphix_pass@localhost:5432/graphix_db
DIRECT_URL=postgresql://graphix_user:graphix_pass@localhost:5432/graphix_db
#
# SUPABASE: two different URLs, and they are not interchangeable.
#   DATABASE_URL -> pooler, port 6543, for app traffic
#   DIRECT_URL   -> direct, port 5432, for prisma db push / migrate
# PgBouncer in transaction mode cannot run the DDL and advisory locks that
# migrations need, which is why the direct URL exists.
#
# DATABASE_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# DIRECT_URL=postgresql://postgres.<ref>:<pw>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ── Auth ──────────────────────────────────────────────────────
# Anyone holding this can forge a valid token for ANY user account, so it
# must be a long random value in production and must never be committed.
#   Generate:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=change_me_generate_a_real_one
JWT_EXPIRES_IN=7d

# ── AI (required for chart generation) ────────────────────────
# Free keys at https://console.groq.com
# Rotation: GROQ_API_KEY_1..50 (GROQ_KEY_1..50 also accepted). Each key on a
# separate Groq account gets its own quota; keys on one account share it.
GROQ_API_KEY=
GROQ_API_KEY_1=
GROQ_API_KEY_2=
GROQ_API_KEY_3=
GROQ_API_KEY_4=
# Groq retires models periodically. If generation fails with model_not_found,
# pick a current one from https://console.groq.com/docs/models
GROQ_MODEL=openai/gpt-oss-120b

# ── Google OAuth (optional) ───────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
