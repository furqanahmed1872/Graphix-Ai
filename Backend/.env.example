# ── Server ────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
# Frontend origin, used for CORS. 3000 = `npm run dev`, 3080 = docker-compose.
CLIENT_URL=http://localhost:3000

# ── Database ──────────────────────────────────────────────────
# Matches the local dev database in docker-compose.dev.yml.
DATABASE_URL=postgresql://graphix_user:graphix_pass@localhost:5432/graphix_db

# ── Auth ──────────────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d

# ── AI (required for chart generation) ────────────────────────
# Get a free key at https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here
# Optional: GROQ_KEY_1 .. GROQ_KEY_50 for round-robin key rotation.
# Optional: override the model. Groq retires models periodically — if you get
# `model_not_found`, check https://console.groq.com/docs/models for a current one.
# GROQ_MODEL=openai/gpt-oss-120b

# ── Google OAuth (optional — only needed for "Sign in with Google") ──
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:5000/api/auth/google/callback
