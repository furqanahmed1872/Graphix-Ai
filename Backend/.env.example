NODE_ENV=production

# Server Configuration
PORT=5000
CLIENT_URL=http://localhost:3080

# Database connection string
# Format: postgresql://username:password@host:port/database
# Local development: postgresql://graphix_user:graphix_pass@localhost:5432/graphix_db
# Docker: postgresql://graphix_user:graphix_pass@host.docker.internal:5432/graphix_db
DATABASE_URL=postgresql://graphix_user:graphix_pass@host.docker.internal:5432/graphix_db

# JWT Secret
JWT_SECRET=your_jwt_secret_key_here

# API Keys
GROQ_API_KEY=your_groq_api_key_here
